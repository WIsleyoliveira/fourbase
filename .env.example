# Supabase (backend) — projeto weflow-producao (sa-east-1). Sem estas duas
# variáveis o servidor cai automaticamente no banco local mockado (data/db.json).
SUPABASE_URL=https://seaibmpzkdvhclveckgs.supabase.co
SUPABASE_ANON_KEY=sb_publishable_fZI5a3C22Bioib4y50TM5w_BWH7mPL1

# Supabase (frontend — upload direto para o Storage, mesmo projeto acima)
VITE_SUPABASE_URL=https://seaibmpzkdvhclveckgs.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_fZI5a3C22Bioib4y50TM5w_BWH7mPL1

# Segredo dos tokens JWT. Obrigatório em produção (NODE_ENV=production) — o
# servidor recusa subir sem ele. Gere um valor forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# Porta do servidor Express (server.js lê API_PORT, não PORT)
API_PORT=3001

# Origem pública usada nos links de convite (/activate/:token). Sem isto, o
# backend usa o header Origin da requisição — defina em produção para não
# depender dele atrás de proxy/CDN.
# APP_URL=https://app.seudominio.com.br

# Ambiente — habilita a checagem obrigatória de JWT_SECRET acima.
NODE_ENV=production

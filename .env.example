# Supabase (backend). Sem SUPABASE_URL o servidor cai automaticamente no banco
# local mockado (data/db.json) — é o recomendado para desenvolvimento, para não
# gravar no banco de produção.
#
# Em produção use a chave service_role (Supabase → Project Settings → API).
# Ela ignora RLS e é SECRETA: só no servidor/Vercel, nunca com prefixo VITE_.
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role ou sb_secret_...>

# Supabase (frontend — upload direto para o Storage, mesmo projeto acima)
VITE_SUPABASE_URL=https://seaibmpzkdvhclveckgs.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_fZI5a3C22Bioib4y50TM5w_BWH7mPL1

# Segredo dos tokens JWT. Obrigatório em produção (NODE_ENV=production) — o
# servidor recusa subir sem ele. Gere um valor forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# Porta do servidor Express (server.js lê API_PORT, não PORT)
API_PORT=3001

# Origem pública usada nos links de convite (/activate/:token), nos links dos
# e-mails de notificação e como única origem externa liberada no CORS. Sem isto,
# o backend usa o header Origin da requisição nos convites (defina em produção
# para não depender dele atrás de proxy/CDN) e NÃO envia e-mails de notificação
# (o sino continua funcionando); os links dos e-mails usam só APP_URL.
# APP_URL=https://app.seudominio.com.br

# E-mail de notificações (Resend). Sem RESEND_API_KEY o servidor só registra o
# e-mail no log e não envia nada — é o comportamento de desenvolvimento/testes.
# Sem domínio verificado no Resend, só entrega ao e-mail dono da conta.
# RESEND_API_KEY=re_...
# EMAIL_FROM=FOURBASE <avisos@seudominio.com.br>

# Ambiente — habilita a checagem obrigatória de JWT_SECRET acima.
NODE_ENV=production
